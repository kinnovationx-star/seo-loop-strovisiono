{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "YOUR_CLIENT-seo-loop-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [{ "binding": "SEO_JOBS", "queue": "YOUR_CLIENT-seo-jobs" }],
    "consumers": [{ "queue": "YOUR_CLIENT-seo-jobs", "max_batch_size": 1, "max_retries": 3 }]
  }
}
